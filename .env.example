# ===== 复制为 .env 使用（真实 .env 已被 .gitignore 忽略，不要提交） =====
# Next.js 自动加载 .env；Docker / compose 注入的同名环境变量优先级更高

# --- 本地开发数据库（Docker PostgreSQL 17）---
APP_ENV=development
APP_PROJECT=life_hub
DB_BACKEND=postgresql
# 实际连接串放忽略的 .env.development.local，仅使用 life_hub_dev_app。
# 不填默认密码；示例格式见 README.md。
DATABASE_URL=
# 自动化测试仅从 .env.test.local 读取 TEST_DATABASE_URL，不回退 DATABASE_URL。
# 迁移凭据独立放 configs/.env.<development|testing>.migration.local，不能放本文件。

# --- 既有 SQLite 部署兼容 ---
# 仅 APP_ENV=production、DB_BACKEND=sqlite 的既有部署使用。
DB_FILE_NAME=data/life-hub.db

# --- 应用 ---
# 对外访问地址，用于拼接邮箱激活链接；https 开头时会话 Cookie 自动加 Secure
APP_URL=http://127.0.0.1:3000
# Docker 对外默认端口为 8787，部署时将 APP_URL 改为实际访问地址。
# 默认忽略代理头，直连请求共用认证限流桶。
# 仅当应用端口禁止直连，且可信反代覆盖/追加 X-Forwarded-For 时设为 true。
TRUST_PROXY=false

# --- 邮件（邮箱注册验证） ---
# console：验证链接打印到服务日志（本地开发默认）；smtp：真实发信（需 SMTP_HOST）
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- 会话与密码 ---
# 登录会话有效天数（剩余不足一半时自动滑动续期）
SESSION_TTL_DAYS=7
# bcrypt 计算强度（4-15，越大越慢越安全）
BCRYPT_ROUNDS=10
