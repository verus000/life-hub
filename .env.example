# ===== 复制为 .env 使用（真实 .env 已被 .gitignore 忽略，不要提交） =====
# Next.js 自动加载 .env；Docker / compose 注入的同名环境变量优先级更高

# --- 本地开发数据库（Docker PostgreSQL 17）---
APP_ENV=development
APP_PROJECT=life_hub
# 实际连接串放忽略的 .env.development.local，仅使用 life_hub_dev_app。
# 不填默认密码；示例格式见 README.md。
DATABASE_URL=
# 自动化测试仅从 .env.test.local 读取 TEST_DATABASE_URL，不回退 DATABASE_URL。
# 迁移凭据独立放 configs/.env.<development|testing>.migration.local，不能放本文件。

# --- Docker 应用（数据库由外部网络提供）---
# 容器连接使用对应环境的公共服务 DNS，不使用容器自身的 127.0.0.1。
# 开发示例：local-shared-dev-postgres-1:5432 / local-shared-dev_database
DATABASE_NETWORK=local-shared-dev_database
APP_PORT=8787

# --- 生产 PostgreSQL（单独配置；此文件不含已确认的生产目标）---
# APP_ENV=production，数据库精确为 life_hub_prod，账号为 life_hub_prod_app。
# 生产必须填写并匹配以下允许目标，连接强制校验 TLS；禁止复用本地实例。
DATABASE_ALLOWED_HOST=
DATABASE_ALLOWED_PORT=
# 如使用私有 CA，在运行环境挂载其证书，填写容器可读路径。
DATABASE_SSL_CA_FILE=

# --- 应用 ---
# 路径前缀：留空部署在根路径，也可填 /life-hub（构建时固定，变更后必须重新构建）。
# Compose 从 .env 读取并作为 build arg 传入；单独 docker build 需显式 --build-arg。
NEXT_PUBLIC_BASE_PATH=
# 对外完整访问地址，包含上面的路径前缀；https 开头时会话 Cookie 自动加 Secure。
# 子路径示例：NEXT_PUBLIC_BASE_PATH=/life-hub，APP_URL=https://life.example.com/life-hub
APP_URL=http://127.0.0.1:3000
# Docker 对外默认端口为 8787，部署时将 APP_URL 改为实际访问地址。
# 默认忽略代理头，直连请求共用认证限流桶。
# 仅当应用端口禁止直连，且可信反代覆盖/追加 X-Forwarded-For 时设为 true。
TRUST_PROXY=false

# --- 邮件（邮箱注册验证） ---
# 默认关闭：注册后直接登录，不发验证邮件；以后设为 true 可启用。
EMAIL_VERIFICATION_REQUIRED=false
# 仅启用验证时生效。console：链接打印到日志；smtp：真实发信（需 SMTP_HOST）
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- 会话与密码 ---
# 登录会话有效天数（剩余不足一半时自动滑动续期）
SESSION_TTL_DAYS=7
# bcrypt 计算强度（4-15，越大越慢越安全）
BCRYPT_ROUNDS=10
