# ===== 复制为 .env 使用（真实 .env 已被 .gitignore 忽略，不要提交） =====
# Docker / compose 直接注入同名环境变量时优先级高于本文件

# --- 服务 ---
# 监听地址：本机运行保持 127.0.0.1；Docker 容器内应为 0.0.0.0
HOST=127.0.0.1
PORT=8787
# 拼接验证邮件里的激活链接（对外可访问的地址）
APP_URL=http://127.0.0.1:8787

# --- 数据库 ---
# 类型：sqlite / json / mysql / postgres
DB_TYPE=sqlite
# sqlite / json 的数据文件路径
DB_FILE=./data/life-hub.db
# 外部数据库（mysql / postgres）时填写
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=lifehub
# 仅 postgres：是否启用 SSL（true / false）
# DB_SSL=false

# --- 邮件（邮箱注册验证） ---
# smtp：真实发送；console：验证链接打印到服务日志（本地调试用）
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- 会话与密码 ---
# 登录会话有效天数（滑动续期）
SESSION_TTL_DAYS=7
# bcrypt 计算强度（10-12，越大越慢越安全）
BCRYPT_ROUNDS=10
# Cookie 名称（一般无需修改）
# COOKIE_NAME=life_hub_session
